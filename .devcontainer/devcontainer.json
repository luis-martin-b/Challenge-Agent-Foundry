{
  "name": "SkyNova Foundry Agent",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "postCreateCommand": "pip install --user -r requirements.txt",
  "remoteEnv": {
    "FOUNDRY_PROJECT_ENDPOINT": "https://foundry-tecnun-resource.services.ai.azure.com/api/projects/foundry-tecnun-project",
    "FOUNDRY_AGENT_NAME": "skynova-customer-care"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-azureresourcegroups"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
